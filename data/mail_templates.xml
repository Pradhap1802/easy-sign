<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <template id="sign_template_mail" name="Signature Request">
            <t t-set="base_url" t-value="request.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
            <t t-set="link" t-value="base_url + '/sign/document/' + str(record.id) + '/' + access_token"/>
            <div>
                <p>Hello <t t-esc="recipient.name"/>,</p>
                <p>You have been invited to sign the document: <t t-esc="record.reference"/></p>
                <p>Please click on the link below to sign it:</p>
                <p><a t-att-href="link">Sign Document</a></p>
            </div>
        </template>

        <template id="sign_template_mail_completed" name="Document Signed">
            <t t-set="base_url" t-value="request.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
            <t t-set="link" t-value="base_url + '/sign/document/' + str(record.id) + '/' + access_token"/>
            <div>
                <p>Hello <t t-esc="recipient_name"/>,</p>
                <p>All signers have signed the document: <t t-esc="record.reference"/></p>
                <p>You can view the signed document at the link below:</p>
                <p><a t-att-href="link">View Signed Document</a></p>
            </div>
        </template>
    </data>
</odoo>
