<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sign_template_sign_now_wizard_form" model="ir.ui.view">
        <field name="name">sign.template.sign.now.wizard.form</field>
        <field name="model">sign.template.sign.now.wizard</field>
        <field name="arch" type="xml">
            <form string="New Signature Request">
                <group>
                    <field name="signer_line_ids" readonly="1" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="role_id" string="Role"/>
                            <field name="partner_id" string="Signer"/>
                        </list>
                    </field>
                    <field name="hide_certificate" string="Hide certificate key on pages"/>
                </group>
                <group>
                    <field name="subject"/>
                    <field name="cc_ids" widget="many2many_tags" placeholder="Write email or search contact..."/>
                    <field name="message" placeholder="Enter your message..."/>
                </group>
                <footer>
                    <button name="action_sign_now" string="Sign Now" type="object" class="oe_highlight"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sign_template_sign_now_wizard" model="ir.actions.act_window">
        <field name="name">New Signature Request</field>
        <field name="res_model">sign.template.sign.now.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
