<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_editor">
        <t t-call="web.html_container">
            <t t-foreach="web.assets_common" t-as="asset">
                <t t-esc="asset"/>
            </t>
            <t t-call="web.frontend_layout">
                <div class="container">
                    <h1>Edit Template</h1>
                    <div id="o_template_editor">
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
