                <body>
            <style>
                body {
                    font-family: "Inter", "Segoe UI", Roboto, Arial, sans-serif;
                    margin: 0;
                    padding: 0;
                    background-color: #525659;
                    color: white;
                }
                .es-top-toolbar {
                    background-color: #2c323f;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
