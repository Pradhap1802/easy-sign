<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem id="menu_sign" name="Sign" sequence="65"/>

        <!-- Reorder Documents and Templates menus -->
        <menuitem id="menu_sign_request" name="Documents" parent="easy_sign.menu_sign" action="action_sign_request" sequence="10"/>
        <menuitem id="menu_sign_template" name="Templates" parent="easy_sign.menu_sign" action="action_sign_template" sequence="20"/>

        <!-- Reports window action & menu -->
        <record id="action_sign_report" model="ir.actions.act_window">
            <field name="name">Reports</field>
            <field name="res_model">sign.request</field>
            <field name="view_mode">graph,pivot</field>
        </record>
        <menuitem id="menu_sign_report" name="Reports" parent="easy_sign.menu_sign" action="action_sign_report" sequence="30"/>

        <!-- Configuration dropdown parent -->
        <menuitem id="menu_sign_config" name="Configuration" parent="easy_sign.menu_sign" sequence="40"/>

        <!-- Field Types window action & menu -->
        <record id="action_sign_item_type" model="ir.actions.act_window">
            <field name="name">Field Types</field>
            <field name="res_model">sign.item.type</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_sign_config_types" name="Field Types" parent="easy_sign.menu_sign_config" action="action_sign_item_type" sequence="20"/>

        <!-- Tags window action & menu -->
        <record id="action_sign_tag" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">sign.tag</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_sign_config_tags" name="Tags" parent="easy_sign.menu_sign_config" action="action_sign_tag" sequence="30"/>
    </data>
</odoo>
