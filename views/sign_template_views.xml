<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sign_template_form" model="ir.ui.view">
            <field name="name">sign.template.form</field>
            <field name="model">sign.template</field>
            <field name="arch" type="xml">
                <form string="Sign Template">
                    <header>
                        <button name="go_to_custom_template" string="Edit Template" type="object" class="oe_highlight"/>
                        <button string="Send" type="action" name="easy_sign.action_sign_send_request"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id" string="Responsible"/>
                                <field name="num_pages" string="Number of pages"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sign_template_list" model="ir.ui.view">
            <field name="name">sign.template.list</field>
            <field name="model">sign.template</field>
            <field name="arch" type="xml">
                <list string="Sign Templates" js_class="sign_request_list">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="num_pages"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_sign_template_kanban" model="ir.ui.view">
            <field name="name">sign.template.kanban</field>
            <field name="model">sign.template</field>
            <field name="arch" type="xml">
                <kanban string="Sign Templates" class="o_kanban_mobile" js_class="sign_request_kanban">
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                    <div>
                                        <field name="user_id"/>
                                    </div>
                                    <div>
                                        <field name="num_pages"/> pages
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_sign_template" model="ir.actions.act_window">
            <field name="name">Sign Templates</field>
            <field name="res_model">sign.template</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

    </data>
</odoo>
