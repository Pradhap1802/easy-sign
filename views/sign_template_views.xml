<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Kanban View ─────────────────────────────────────── -->
    <record id="view_sign_template_kanban" model="ir.ui.view">
        <field name="name">sign.template.kanban</field>
        <field name="model">sign.template</field>
        <field name="arch" type="xml">
            <kanban string="Sign Templates" default_group_by="" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="field_count"/>
                <field name="signer_count"/>
                <field name="request_count"/>
                <field name="pdf_document_name"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click" style="padding:0;overflow:hidden;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,0.08);">
                            <!-- Card header (gradient) -->
                            <div style="background:linear-gradient(135deg,#1a1a2e,#0f3460);padding:20px 16px 14px;text-align:center;">
                                <div style="width:52px;height:52px;background:rgba(255,255,255,0.15);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:10px;">
                                    <span style="font-size:24px;">📄</span>
                                </div>
                                <div style="color:#fff;font-weight:700;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" t-esc="record.name.value"/>
                                <div style="color:rgba(255,255,255,0.6);font-size:11px;margin-top:4px;" t-esc="record.pdf_document_name.value or 'PDF Document'"/>
                            </div>
                            <!-- Stats row -->
                            <div style="display:flex;justify-content:space-around;padding:10px 8px;border-bottom:1px solid #f1f5f9;">
                                <div style="text-align:center;">
                                    <div style="font-size:18px;font-weight:700;color:#2563eb;" t-esc="record.field_count.value"/>
                                    <div style="font-size:10px;color:#94a3b8;">Fields</div>
                                </div>
                                <div style="text-align:center;">
                                    <div style="font-size:18px;font-weight:700;color:#7c3aed;" t-esc="record.signer_count.value"/>
                                    <div style="font-size:10px;color:#94a3b8;">Signers</div>
                                </div>
                                <div style="text-align:center;">
                                    <div style="font-size:18px;font-weight:700;color:#16a34a;" t-esc="record.request_count.value"/>
                                    <div style="font-size:10px;color:#94a3b8;">Used</div>
                                </div>
                            </div>
                            <!-- Action buttons -->
                            <div style="display:flex;gap:8px;padding:10px 12px;">
                                <button name="action_edit_template" type="object"
                                        style="flex:1;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;border:none;padding:8px 0;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">
                                    ✏️ Edit
                                </button>
                                <button name="action_use_template" type="object"
                                        style="flex:1;background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;border:none;padding:8px 0;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">
                                    📤 Send
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ─── List View ───────────────────────────────────────── -->
    <record id="view_sign_template_list" model="ir.ui.view">
        <field name="name">sign.template.list</field>
        <field name="model">sign.template</field>
        <field name="arch" type="xml">
            <list string="Sign Templates">
                <field name="name"/>
                <field name="pdf_document_name" string="Document"/>
                <field name="field_count" string="Fields"/>
                <field name="signer_count" string="Signers Required"/>
                <field name="request_count" string="Requests Sent"/>
                <button name="action_edit_template" type="object" string="Edit" icon="fa-pencil" class="btn-sm btn-primary"/>
                <button name="action_use_template" type="object" string="Send" icon="fa-paper-plane" class="btn-sm btn-success"/>
            </list>
        </field>
    </record>

    <!-- ─── Form View ───────────────────────────────────────── -->
    <record id="view_sign_template_form" model="ir.ui.view">
        <field name="name">sign.template.form</field>
        <field name="model">sign.template</field>
        <field name="arch" type="xml">
            <form string="Sign Template">
                <header>
                    <button name="action_edit_template" string="Edit Template (Add Fields)"
                            type="object" class="btn-primary" icon="fa-pencil"/>
                    <button name="action_use_template" string="Use Template (Send)"
                            type="object" class="btn-success" icon="fa-paper-plane"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_requests" icon="fa-file-signature">
                            <field name="request_count" widget="statinfo" string="Requests"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_edit_template" icon="fa-th-large">
                            <field name="field_count" widget="statinfo" string="Fields"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="pdf_document" widget="binary"
                                   string="PDF Document" filename="pdf_document_name"/>
                            <field name="pdf_document_name" invisible="1"/>
                            <field name="signer_count" readonly="1"/>
                        </group>
                        <group string="Info">
                            <field name="description"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="field_ids" readonly="1">
                                <list>
                                    <field name="field_type" widget="badge"/>
                                    <field name="signer_index" string="Signer #"/>
                                    <field name="page" string="Page"/>
                                    <field name="placeholder"/>
                                    <field name="required"/>
                                    <field name="pos_x" string="X %"/>
                                    <field name="pos_y" string="Y %"/>
                                    <field name="width" string="W %"/>
                                    <field name="height" string="H %"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2" style="font-size:13px;">
                                <i class="fa fa-info-circle"/> Click <strong>Edit Template</strong> above to drag-and-drop fields onto the PDF.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── Search View ─────────────────────────────────────── -->
    <record id="view_sign_template_search" model="ir.ui.view">
        <field name="name">sign.template.search</field>
        <field name="model">sign.template</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="name"/>
                <field name="pdf_document_name"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- ─── Window Action ───────────────────────────────────── -->
    <record id="action_sign_template" model="ir.actions.act_window">
        <field name="name">Sign Templates</field>
        <field name="res_model">sign.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_sign_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first document template
            </p>
            <p>
                Upload a PDF, place signature fields, name fields, date fields and more.
                Then send the template to clients who fill and sign it online.
            </p>
        </field>
    </record>

</odoo>
