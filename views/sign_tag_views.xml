<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sign_tag_list" model="ir.ui.view">
        <field name="name">sign.tag.list</field>
        <field name="model">sign.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="view_sign_tag_form" model="ir.ui.view">
        <field name="name">sign.tag.form</field>
        <field name="model">sign.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <group>
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </group>
            </form>
        </field>
    </record>
</odoo>
