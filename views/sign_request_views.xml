<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sign_request_form" model="ir.ui.view">
            <field name="name">sign.request.form</field>
            <field name="model">sign.request</field>
            <field name="arch" type="xml">
                <form string="Sign Request">
                    <header>
                        <button name="go_to_edit_template" string="Edit Template" type="object" class="oe_highlight"/>
                        <button name="send_signature_accesses" string="Send" type="object" invisible="state != 'sent'" class="oe_highlight"/>
                        <button name="cancel" string="Cancel" type="object" invisible="state != 'sent'" class="btn-danger"/>
                        <button name="go_to_signable_document" string="Sign Document" type="object" invisible="state != 'sent'" class="oe_highlight"/>
                        <button name="get_completed_document" string="Download Signed Document" type="object" invisible="state != 'signed'"/>
                        <field name="state" widget="statusbar" statusbar_visible="sent,signed,canceled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="reference"/></h1>
                        </div>
                        <group>
                            <group string="Document">
                                <field name="document" filename="document_filename"/>
                                <field name="document_filename" invisible="1"/>
                                <field name="template_id"/>
                                <field name="subject"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group string="Info">
                                <field name="progress" string="Progress"/>
                                <field name="completion_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Signers" name="signers">
                                <field name="request_item_ids">
                                    <list editable="bottom">
                                        <field name="partner_id"/>
                                        <field name="role_id"/>
                                        <field name="state" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Logs" name="logs">
                                <field name="sign_log_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sign_request_list" model="ir.ui.view">
            <field name="name">sign.request.list</field>
            <field name="model">sign.request</field>
            <field name="arch" type="xml">
                <list string="Sign Requests">
                    <field name="reference"/>
                    <field name="template_id"/>
                    <field name="state"/>
                    <field name="progress"/>
                    <field name="completion_date"/>
                </list>
            </field>
        </record>

        <record id="view_sign_request_kanban" model="ir.ui.view">
            <field name="name">sign.request.kanban</field>
            <field name="model">sign.request</field>
            <field name="arch" type="xml">
                <kanban string="Sign Requests" class="o_kanban_mobile">
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <strong><field name="reference"/></strong>
                                    <div>
                                        <field name="template_id"/>
                                    </div>
                                    <div class="text-right">
                                        <field name="progress"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_sign_request" model="ir.actions.act_window">
            <field name="name">Sign Requests</field>
            <field name="res_model">sign.request</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <menuitem id="menu_sign_request" name="Documents" parent="easy_sign.menu_sign" action="action_sign_request" sequence="20"/>
    </data>
</odoo>
