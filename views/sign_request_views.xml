<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sign_request_form" model="ir.ui.view">
            <field name="name">sign.request.form</field>
            <field name="model">sign.request</field>
            <field name="arch" type="xml">
                <form string="Sign Request">
                    <header>
                        <button name="go_to_edit_template" string="Edit Template" type="object" class="oe_highlight"/>
                        <button name="action_open_send_wizard" string="Send" type="object" invisible="state != 'sent'" class="oe_highlight"/>
                        <button name="cancel" string="Cancel" type="object" invisible="state != 'sent'" class="btn-danger"/>
                        <button name="go_to_signable_document" string="Sign Document" type="object" invisible="state != 'sent'" class="oe_highlight"/>
                        <button name="get_completed_document" string="Download Signed Document" type="object" invisible="state != 'signed'"/>
                        <field name="state" widget="statusbar" statusbar_visible="sent,signed,canceled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="reference"/></h1>
                        </div>
                        <group>
                            <group string="Document">
                                <field name="document" filename="document_filename"/>
                                <field name="document_filename" invisible="1"/>
                                <field name="template_id"/>
                                <field name="subject"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group string="Info">
                                <field name="progress" string="Progress"/>
                                <field name="completion_date"/>
                                <field name="validity_date" string="Valid Until"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Signers" name="signers" invisible="not signer_ids">
                                <field name="signer_ids" readonly="1">
                                    <list>
                                        <field name="sequence" string="Seq"/>
                                        <field name="role_id"/>
                                        <field name="partner_id"/>
                                        <field name="state" widget="badge" decoration-success="state == 'signed'" decoration-info="state == 'sent'" decoration-muted="state == 'draft'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_sign_request_list" model="ir.ui.view">
            <field name="name">sign.request.list</field>
            <field name="model">sign.request</field>
            <field name="arch" type="xml">
                <list string="Sign Requests" js_class="sign_request_list">
                    <field name="create_date" string="Date"/>
                    <field name="reference" string="Name"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" string="Tags"/>
                    <field name="create_uid" string="Sent by"/>
                    <field name="state" string="Status" widget="badge" decoration-success="state == 'signed'" decoration-info="state == 'sent'" decoration-danger="state == 'canceled'"/>
                    <field name="validity_date" string="Valid Until"/>
                    <button name="go_to_signable_document" string="Sign" type="object" icon="fa-pencil" class="btn-link" invisible="state != 'sent'"/>
                    <button name="get_completed_document" string="Download" type="object" icon="fa-download" class="btn-link" invisible="state != 'signed'"/>
                </list>
            </field>
        </record>

        <record id="view_sign_request_kanban" model="ir.ui.view">
            <field name="name">sign.request.kanban</field>
            <field name="model">sign.request</field>
            <field name="arch" type="xml">
                <kanban string="Sign Requests" class="o_kanban_mobile" js_class="sign_request_kanban">
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <strong><field name="reference"/></strong>
                                    <div>
                                        <field name="template_id"/>
                                    </div>
                                    <div class="text-right">
                                        <field name="progress"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_sign_request_search" model="ir.ui.view">
            <field name="name">sign.request.search</field>
            <field name="model">sign.request</field>
            <field name="arch" type="xml">
                <search string="Search Requests">
                    <field name="reference" string="Name"/>
                    <field name="tag_ids" string="Tags"/>
                    <filter string="To Sign" name="to_sign" domain="[('state', '=', 'sent')]"/>
                    <filter string="Signed" name="signed" domain="[('state', '=', 'signed')]"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Tags" name="group_by_tags" context="{'group_by': 'tag_ids'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_sign_request" model="ir.actions.act_window">
            <field name="name">Sign Requests</field>
            <field name="res_model">sign.request</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_sign_request_search"/>
            <field name="context">{'search_default_active': 1}</field>
            <field name="path">sign-requests</field>
        </record>
    </data>
</odoo>
